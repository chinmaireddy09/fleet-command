{
  "_comment": "EXAMPLE ONLY. The real file lives at ~/.claude/mission-control.json and is written by `/mc deploy` the first time you run it on a machine. Do not copy this into a repo — spawn preferences are per-person, and a clone carrying someone else's terminal choice is a bug, not a default.",

  "spawn": {
    "platform": "darwin",
    "terminal": "Apple_Terminal",
    "placement": "auto",
    "launchCommand": "claude",
    "permissionMode": null
  },

  "naming": {
    "_comment": "Asked ONCE, at the first identification of a fleet, then never again. A call-sign is what people say; a handle is what peers address. They are the same unless the user says otherwise -- and a call-sign with a space cannot be a session name, so that case must be asked. NEVER derive a handle from a call-sign.",
    "coordinator": "CONTROL",
    "handles": {
      "FLEET COMMAND": "FLEETCOM"
    }
  },

  "_fields": {
    "platform": "darwin | linux | win32 — from `uname -s` or $OS",
    "terminal": "Apple_Terminal | iTerm.app | vscode | WindowsTerminal | ghostty | WarpTerminal | other — detected from $TERM_PROGRAM or $WT_SESSION, then CONFIRMED with the user. Detection is not consent: $TERM_PROGRAM says where Control is running, not where stations should appear.",
    "placement": "print | tab | window. DEFAULT IS auto: /mc deploy opens the tab and runs the command, because asking to deploy IS the authorisation to automate. /mc station and hand-started sessions print instead, and the automated path prints too the moment it cannot verify a claude process started. Chosen 2026-08-18 after measuring the alternative -- synthesising Cmd-T is the same keypress a finger makes and the only version that can misfire, and it did: the modifier lost its race, the bare t reached the shell, and a station ran `tcd /path && claude`. The same synthetic keypress also lands in whichever window has focus. tab still works and needs Accessibility (System Settings -> Privacy & Security -> Accessibility -> Terminal); it targets its own window by tty and verifies a claude process really started.",
    "launchCommand": "usually `claude`; override if the CLI is installed under another name",
    "coordinator": "what THIS user calls the coordinating station -- CONTROL, FLEET COMMAND, or their own word. The skill has no opinion and must not act as though it does.",
    "handles": "call-sign -> address, only for the ones that differ. A call-sign with a space cannot be a session name; a user may also just prefer a short address for a long call-sign. Both are legitimate and neither is derivable, so both are asked.",
    "permissionMode": "null by default, and deploy NEVER sets this on your behalf. null means a spawned station prompts for its own pushes, exactly like any session, and deploy tells you to approve in the new tab. Setting it to anything else widens what a spawned session may do unattended — your choice, in your own file."
  },

  "_terminalsVerified": {
    "Apple_Terminal": "print path VERIFIED end-to-end 2026-08-18. Tab path FAILED TWICE IN THE FIELD on 2026-08-17 -- a lost modifier race corrupted the command into `tcd`, and the synthetic keypress opened the tab in whichever window had focus. Since rewritten to target its own window by tty and to verify a claude process really started, and to print the paste-able command whenever it cannot; that rewrite is dry-run checked but its full spawn has NOT been re-run in the field. Window fallback works.",
    "iTerm.app": "recipe shipped, UNVERIFIED",
    "WindowsTerminal": "recipe shipped, UNVERIFIED",
    "vscode": "no recipe exists — nothing outside the editor can open its integrated terminal reliably. Falls back to printing the exact command to paste.",
    "other": "falls back to printing the command. That is a supported outcome, not a failure — the call-sign and path are filled in and cannot be mistyped."
  }
}
